{
  "name": "night-float",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Night Float — first-person ICU simulation in the browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
